# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (resend.com → API Keys). Without a domain, Resend only delivers to your own address. ──
RESEND_API_KEY=
EMAIL_FROM=Xopa <onboarding@resend.dev>

# ── Admins: comma-separated emails that get /admin access ──
ADMIN_EMAILS=

# ── Secrets: any long random strings ──
SCANNER_SECRET=
CRON_SECRET=

# ── Payments ──
# Test mode: simulated payments to try the full flow. Turn OFF before real sales.
PAYMENTS_MOCK=true
# Stripe (later)
PAYMENTS_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Yappy (later)
PAYMENTS_YAPPY_ENABLED=false
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
YAPPY_DOMAIN=
